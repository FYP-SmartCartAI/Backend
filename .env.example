# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRE=30d

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get API keys from https://aistudio.google.com/app/apikey
#
# Single-key alias (for simple setups):
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
#
# Multi-key rotation: when one key hits its free-tier quota (429 error) the
# server automatically switches to the next key — no restart needed.
# Add as many keys as you have (GEMINI_API_KEY_1, _2, _3 … _N).
# The pool is built at startup by reading all GEMINI_API_KEY_* variables.
# If you only have one key, set it as both GEMINI_API_KEY and GEMINI_API_KEY_1.
GEMINI_API_KEY_1=YOUR_GEMINI_API_KEY_1
GEMINI_API_KEY_2=YOUR_GEMINI_API_KEY_2
GEMINI_API_KEY_3=YOUR_GEMINI_API_KEY_3
GEMINI_API_KEY_4=YOUR_GEMINI_API_KEY_4
GEMINI_API_KEY_5=YOUR_GEMINI_API_KEY_5
GEMINI_API_KEY_6=YOUR_GEMINI_API_KEY_6
GEMINI_API_KEY_7=YOUR_GEMINI_API_KEY_7
GEMINI_API_KEY_8=YOUR_GEMINI_API_KEY_8
GEMINI_API_KEY_9=YOUR_GEMINI_API_KEY_9
GEMINI_API_KEY_10=YOUR_GEMINI_API_KEY_10
# Add more keys below if needed — GEMINI_API_KEY_11, _12, etc.

# ── Pinecone ──────────────────────────────────────────────────────────────────
# Get these from https://app.pinecone.io → your project → API Keys
PINECONE_API_KEY=YOUR_PINECONE_API_KEY
PINECONE_INDEX_NAME=YOUR_PINECONE_INDEX_NAME
# Minimum cosine similarity for AI search results (default 0.58)
# PINECONE_MIN_SCORE=0.58
# Environment is required by older Pinecone SDK versions (v2 and below).
# Pinecone SDK v3+ no longer requires it but kept here for documentation.
PINECONE_ENVIRONMENT=us-east-1-aws

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# The recommended approach is to encode the entire service account JSON as base64.
# 1. Go to https://console.firebase.google.com → Project Settings → Service accounts
# 2. Click "Generate new private key" → download the JSON file
# 3. Base64-encode it:  base64 -i serviceAccountKey.json | tr -d '\n'
# 4. Paste the result as FIREBASE_SERVICE_ACCOUNT_B64
FIREBASE_SERVICE_ACCOUNT_B64=BASE64_OF_YOUR_FIREBASE_SERVICE_ACCOUNT_JSON
#
# Individual fields (extracted from the JSON above — for documentation only,
# the app uses FIREBASE_SERVICE_ACCOUNT_B64):
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Get these from https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY
# Get this from https://dashboard.stripe.com → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET
# Currency for all payments (ISO 4217 code, e.g. PKR, USD, EUR)
STRIPE_CURRENCY=PKR

# ── Abandoned cart recovery ───────────────────────────────────────────────────
# Minutes of cart inactivity before a cart is flagged abandoned (default: 2 for testing)
# Set to 60 in production.
ABANDONED_CART_IDLE_MINUTES=2
# How often the job checks for abandoned carts (dev default: 2 | production default: 60)
ABANDONED_CART_POLL_INTERVAL_MINUTES=2
# Optional raw cron override (takes precedence over ABANDONED_CART_POLL_INTERVAL_MINUTES)
# ABANDONED_CART_CRON=0 * * * *
#
# Groq generates abandoned-cart reminder copy only (semantic search uses Gemini above).
# Get a key from https://console.groq.com
# Groq — abandoned cart recovery + AI search query understanding (product name, category, tags)
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Must match the Authorized Redirect URI configured in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:5000/api/oauth/google/callback

# ── Facebook OAuth 2.0 ────────────────────────────────────────────────────────
# Get these from https://developers.facebook.com → My Apps → your app → Settings → Basic
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET
# Must match the Valid OAuth Redirect URI configured in Facebook App Dashboard
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/oauth/facebook/callback

# ── Email (Nodemailer for password reset OTP) ─────────────────────────────────
# Use a Gmail address with an App Password (not your real password)
# Generate one at https://myaccount.google.com → Security → App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=SmartCart AI <noreply@smartcart.ai>

# ── Abstract API — email reputation (registration validation) ─────────────────
# Get your key from https://app.abstractapi.com/api/email-reputation
ABSTRACT_EMAIL_API_KEY=YOUR_ABSTRACT_EMAIL_API_KEY

# ── Session (for Passport OAuth redirect dance) ───────────────────────────────
SESSION_SECRET=replace_with_a_long_random_string_min_32_chars
